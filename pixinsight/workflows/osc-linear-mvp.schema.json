{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccastro.com/schemas/pixinsight-workflow-v1.schema.json",
  "title": "CCDASTRO PixInsight Workflow",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "input", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["stage", "colorModel"],
      "properties": {
        "stage": { "enum": ["linear-integrated"] },
        "colorModel": { "enum": ["OSC-RGB"] },
        "sampleFormat": { "enum": ["float32", "float64", "any-float"] }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "enabled", "stage", "selectedAdapter", "adapters"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "enabled": { "type": "boolean" },
          "stage": { "enum": ["linear"] },
          "selectedAdapter": { "type": "string" },
          "adapters": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "mustPrecede": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "mustFollow": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
